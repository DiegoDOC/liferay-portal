@component-name = "portal-wcm"
definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Web Content Administration";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONGroup.addGroup(groupName = "Test Site Name");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			JSONGroup.deleteGroupByName(groupName = "Test Site Name");
		}
	}

	@description = "This is a test for LPS-123538. As Content Creator, I want to define reusable translations when creating WEM Structures with fieldset"
	@ignore = "true"
	@priority = "4"
	test CheckFieldsetLocalizationWithDifferentInstanceLanguage {
		property portal.acceptance = "false";

		// TODO LPS-123538 CheckFieldsetLocalizationWithDifferentInstanceLanguage pending implementation

	}

	@description = "This is a test for LPS-123538. As Content Creator, I want to define reusable translations when creating WEM Structures with fieldset"
	@priority = "5"
	test CheckFieldsetTranslationsOnStructure {
		WebContentNavigator.openWebContentAdmin(siteURLKey = "test-site-name");

		NavItem.gotoStructures();

		WebContentStructures.addCP(structureName = "WC Structure Name");

		DataEngine.addFieldsets(
			createNewFieldset = "true",
			fieldNameList = "Text",
			fieldsetLabel = "New Fieldset",
			fieldsetName = "New Fieldset");

		PortletEntry.changeLocale(locale = "pt-BR");

		DataEngine.editFieldsetsLabel(
			fieldsetLabel = "New Fieldset",
			fieldsetLabelEdit = "Novo Fieldset");

		DataEngine.gotoFieldsetItemEllipsis(fieldsetName = "New Fieldset");

		MenuItem.click(menuItem = "Edit");

		PortletEntry.changeLocale(
			locale = "pt-BR",
			modal = "true");

		DataEngine.editFieldLabel(
			fieldFieldLabel = "Text",
			fieldFieldLabelEdit = "Texto",
			fieldsetModal = "true");

		Click(locator1 = "Modal#SAVE_BUTTON");

		Click(
			key_text = "Propagate",
			locator1 = "Button#ANY");

		Alert.viewSuccessMessage();

		WebContentStructures.saveCP();

		WebContentNavigator.gotoEditStructure(structureName = "WC Structure Name");

		AssertTextEquals(
			locator1 = "TextInput#NAME",
			value1 = "WC Structure Name");

		AssertVisible(
			key_fieldsetLabel = "New Fieldset",
			locator1 = "DDMEditStructure#FORM_FIELD_SETS_CONTAINER_LABEL");

		AssertVisible(
			key_fieldFieldLabel = "Text",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER_LABEL");

		PortletEntry.changeLocale(locale = "pt-BR");

		AssertTextEquals(
			locator1 = "TextInput#NAME",
			value1 = "WC Structure Name");

		AssertVisible(
			key_fieldsetLabel = "Novo Fieldset",
			locator1 = "DDMEditStructure#FORM_FIELD_SETS_CONTAINER_LABEL");

		AssertVisible(
			key_fieldFieldLabel = "Texto",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER_LABEL");
	}

