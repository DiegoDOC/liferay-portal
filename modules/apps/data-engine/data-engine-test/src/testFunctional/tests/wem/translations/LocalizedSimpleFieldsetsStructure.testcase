	@description = "This is a test for LPS-123538. As Content Creator, I want to define reusable translations when creating WEM Structures with fieldset"
	@priority = "5"
	test TranslateFieldsetWithNestedNTranslations {
		property portal.acceptance = "false";

		WebContentNavigator.openWebContentAdmin(siteURLKey = "test-site-name");

		var structureName = "Test Structure";
		var testFieldsetEN = "Test Fieldset";
		var testFieldsetPT = "Fieldset Teste";
		var testFieldsetDE = "Test Fieldset DE";
		var testFieldsetJP = "Test Fieldset JP";
		var fieldLabel1EN = "First Text";
		var fieldLabel2EN = "Second Text";
		var fieldLabel1PT = "Primeiro Texto";
		var fieldLabel2PT = "Segundo Texto";
		var fieldLabel1DE = "First Text DE";
		var fieldLabel2DE = "Second Text DE";
		var fieldLabel1JP = "First Text JP";
		var fieldLabel2JP = "Second Text JP";

		NavItem.gotoStructures();

		WebContentStructures.addCP(
			structureDescription = "Structure Description Test",
			structureName = "${structureName}");

		DataEngine.gotoNewFieldset(fieldsetName = "${testFieldsetEN}");

		DataEngine.addFields(fieldNameList = "Text");

		DataEngine.editFieldLabel(
			fieldFieldLabel = "Text",
			fieldFieldLabelEdit = "${fieldLabel1EN}");
	
		DataEngine.addFieldNested(
			fieldFieldLabel = "${fieldLabel2EN}",
			fieldName = "Text",
			targetFieldLabel = "${fieldLabel1EN}");

		DataEngine.changeFieldsetLocale(locale = "pt-BR");

		DataEngine.changeFieldsetName(fieldsetName = "${testFieldsetPT}");

		DataEngine.editFieldLabel(
			fieldFieldLabel = "${fieldLabel1EN}",
			fieldFieldLabelEdit = "${fieldLabel1PT}");

		DataEngine.editFieldLabel(
			fieldFieldLabel = "${fieldLabel2EN}",
			fieldFieldLabelEdit = "${fieldLabel2PT}");
		
		DataEngine.changeFieldsetLocale(locale = "de-DE");

		DataEngine.changeFieldsetName(fieldsetName = "${testFieldsetDE}");

		DataEngine.editFieldLabel(
			fieldFieldLabel = "${fieldLabel1EN}",
			fieldFieldLabelEdit = "${fieldLabel1DE}");

		DataEngine.editFieldLabel(
			fieldFieldLabel = "${fieldLabel2EN}",
			fieldFieldLabelEdit = "${fieldLabel2DE}");
		
		DataEngine.changeFieldsetLocale(locale = "ja-JP");

		DataEngine.changeFieldsetName(fieldsetName = "${testFieldsetJP}");

		DataEngine.editFieldLabel(
			fieldFieldLabel = "${fieldLabel1EN}",
			fieldFieldLabelEdit = "${fieldLabel1JP}");

		DataEngine.editFieldLabel(
			fieldFieldLabel = "${fieldLabel2EN}",
			fieldFieldLabelEdit = "${fieldLabel2JP}");

		Click(locator1 = "Modal#SAVE_BUTTON");

		FormViewBuilder.goToFieldsetsTab();

		DoubleClick(
			key_fieldName = "${testFieldsetEN}",
			locator1 = "Sidebar#ADD_FIELD_NAME");
			
		WebContentStructures.saveCP();

		WebContentNavigator.gotoEditStructure(structureName = "${structureName}");

		PortletEntry.changeLocale(locale = "pt_BR");

		AssertElementPresent(
			key_fieldFieldLabel = "${fieldLabel1PT}",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER");

		AssertElementPresent(
			key_fieldFieldLabel = "${fieldLabel2PT}",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER");

		PortletEntry.changeLocale(locale = "de_DE");

		AssertElementPresent(
			key_fieldFieldLabel = "${fieldLabel1DE}",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER");

		AssertElementPresent(
			key_fieldFieldLabel = "${fieldLabel2DE}",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER");
		
		PortletEntry.changeLocale(locale = "ja_JP");

		AssertElementPresent(
			key_fieldFieldLabel = "${fieldLabel1JP}",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER");

		AssertElementPresent(
			key_fieldFieldLabel = "${fieldLabel2JP}",
			locator1 = "DDMEditStructure#FORM_FIELD_CONTAINER");
	}
}